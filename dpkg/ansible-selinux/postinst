#!/bin/bash

bunzip2 /usr/share/selinux/default/ansible.pp.bz2
semodule -i /usr/share/selinux/default/ansible.pp
RC=$?
bzip2 /usr/share/selinux/default/ansible.pp

if selinuxenabled
then
  restorecon -RFi /{opt,srv}/ansible 
  restorecon -RFi /{lib,etc}/systemd/system/ansible*
  restorecon -RFi /var/{lib,log,run,tmp}/ansible
  restorecon -RFi /usr/share/man
fi

exit $RC