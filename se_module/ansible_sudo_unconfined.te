policy_module(ansible_sudo_unconfined, 0.1.0)

########################################
#
# Requires
#
########################################

gen_require(`
        attribute unconfined_domain_type;
        type ansible_sudo_t;
')

########################################
#
# Policy for ansible_sudo_t domain
#
########################################

role unconfined_r types ansible_sudo_t;

typeattribute ansible_sudo_t unconfined_domain_type;
