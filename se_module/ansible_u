#
## Default SELinux mapping for ansible_u user
#
system_r:local_login_t:s0       ansible_r:ansible_t:s0
system_r:remote_login_t:s0      ansible_r:ansible_t:s0
system_r:sshd_t:s0              ansible_r:ansible_t:s0
system_r:crond_t:s0             ansible_r:ansible_t:s0
system_r:initrc_su_t:s0         ansible_r:ansible_t:s0
ansible_r:ansible_sudo_t:s0     ansible_r:ansible_t:s0 sysadm_r:sysadm_t:s0
